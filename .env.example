# .env로 복사한 뒤 비어 있는 값을 채워 주세요.

# MySQL: 비밀번호는 각각 openssl rand -hex 16으로 생성
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=energycal
MYSQL_USER=energycal_app
MYSQL_PASSWORD=

# JWT 서명 키: openssl rand -base64 48로 생성한 값을 입력
JWT_SECRET=

# Turnstile 공개 테스트 키 (로컬용, 실제 배포 시 교체)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 로컬 실행 프로필과 웹 포트
SPRING_PROFILES_ACTIVE=local
WEB_PORT=8000
